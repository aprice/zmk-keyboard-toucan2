#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

#define BASE 0
#define GAME 1
#define SYM  2
#define NAV  3
#define SYS  4

#define KEYS_L 0 1 2 3 4 5		12 13 14 15 16 17		24 25 26 27 28 29
#define KEYS_R 6 7 8 9 10 11	18 19 20 21 22 23		30 31 32 33 34 35
#define THUMB_L 36 37 38
#define THUMB_R 39 40 41
#define KEYS_T THUMB_L THUMB_R

&sl {
    release-after-ms = <2000>;
};

/ {
    behaviors {
        shift_caps: shift_caps {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&kp LSHFT>, <&kp CAPS>;
        };
        hrm: home_row_mod {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            require-prior-idle-ms = <150>;
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            bindings = <&kp>, <&kp>;
            hold-trigger-on-release;
        };
        lhr: left_home_row_mod {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            require-prior-idle-ms = <150>;
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            bindings = <&kp>, <&kp>;
            hold-trigger-on-release;
    		told-trigger-key-positions = <KEYS_L KEYS_T>;
        };
        rhr: right_home_row_mod {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            require-prior-idle-ms = <150>;
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            bindings = <&kp>, <&kp>;
            hold-trigger-on-release;
    		told-trigger-key-positions = <KEYS_R KEYS_T>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base {
            display-name = "BASE";
            bindings = <
                &kp TAB   &kp Q &kp W &kp E &kp R &kp T   &kp Y &kp U  &kp I     &kp O   &kp P    &kp MINUS
                &kp BSPC &kp A &lhr LALT S &lhr LCTRL D &lhr LGUI F &kp G   &kp H &rhr LGUI J  &rhr LCTRL K     &rhr LALT L   &kp SEMI &kp SQT
                &kp DEL &kp Z &kp X &kp C &kp V &kp B   &kp N &kp M  &kp COMMA &kp DOT &kp FSLH &kp EQUAL
                                &kp ESC &lt 1 SPACE &shift_caps   &lt 1 BSPC &lt 2 RET &kp LS(LC(LALT))
            >;
        };

        Sym_Pad {
            display-name = "SYM";
            bindings = <
                &trans     &kp EXCL          &kp AT       &kp HASH       &kp DLLR       &kp PRCNT         &kp FSLH   &kp N7   &kp N8 &kp N9    &kp MINUS &kp COLON
                &kp LPAR  &kp RPAR    &kp LBRC &kp RBRC &kp LBKT &kp RBKT   &kp STAR &kp N4 &kp N5 &kp N6 &kp PLUS &kp EQUAL
                &kp BSLH   &kp CARET  &kp AMPS       &kp PIPE       &kp TILDE       &kp GRAVE         &kp N0   &kp N1   &kp N2 &kp N3    &kp DOT &tog 1
                                                &trans     &trans       &trans      &trans  &trans   &kp N0
            >;
        };

        Nav {
            display-name = "NAV";
            bindings = <
                &trans   &trans &trans &trans &trans &trans   &kp PG_UP &kp HOME  &kp UP &kp END &trans &trans
                &trans &trans   &trans &trans   &trans   &to 5      &kp PG_DN &kp LEFT &kp DOWN        &kp RIGHT &trans &sl 3
                &trans &trans   &trans &trans   &to 4   &tog 2      &trans &trans  &trans        &trans &trans &trans
                                          &trans &trans   &trans   &trans   &trans    &trans
            >;
        };

        Sys {
            display-name = "SYS";
            bindings = <
                &trans &kp F1 &kp F2 &kp F3 &kp F4 &kp F5 &kp F6 &kp F7 &kp F8 &kp F9
                &kp F10 &kp F11 &bt BT_CLR &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &out OUT_TOG &trans &kp C_PREV
                &kp C_PP &kp C_NEXT &kp C_MUTE &kp F12 &trans &studio_unlock &trans &trans &trans &kp PSCRN
                &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans
                &trans &trans
            >;
        };

        Gaming {
            display-name = "GAME";
            bindings = <
                &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &kp S &kp D &kp F &trans &trans &kp J
                &kp K &kp L &trans &trans &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans &kp ESC &kp SPACE &kp LSHFT &trans
                &kp RET &to 0
            >;
        };
        Mouse {
            bindings = <
                &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &kp LSHFT &trans &trans &trans &to 0 &trans &trans
                &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans &mkp MCLK &mkp LCLK &mkp RCLK &trans
                &trans &trans
            >;
        };
    };
};
